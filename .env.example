# =====================================================================
# Universal GRG CDM Log Analyzer — example environment configuration
# Copy to `.env` (same directory) and adjust values.
# Docker Compose reads this file automatically. For local (non-Docker)
# development you can export the variables or place the .env in the
# project root as well.
# =====================================================================

# ---- Application ----
CDM_ENVIRONMENT=development
CDM_DEBUG=true
CDM_LOG_LEVEL=INFO
CDM_LOG_FORMAT=json            # json | console
CDM_API_PREFIX=/api
# Comma separated list; use * to allow any (development only)
CDM_CORS_ORIGINS=*

# ---- Database (MySQL) ----
# Inside Docker Compose use the service name `mysql`.
CDM_DATABASE_URL=mysql+pymysql://cdm:cdm_password@mysql:3306/cdm_analyzer?charset=utf8mb4
# Local development without Docker (SQLite fallback):
# CDM_DATABASE_URL=sqlite:///./data/cdm_dev.sqlite3

# ---- Redis / Celery ----
# Leave CDM_REDIS_URL empty to run processing jobs in-process (no Redis).
CDM_REDIS_URL=redis://redis:6379/0
CDM_CELERY_BROKER_URL=redis://redis:6379/0
CDM_CELERY_RESULT_BACKEND=redis://redis:6379/0
# Run pipeline tasks synchronously (development/testing only)
CDM_TASK_EAGER=false

# ---- Storage ----
CDM_STORAGE_DIR=./data
CDM_MAX_UPLOAD_SIZE_MB=200
CDM_MAX_EXTRACT_SIZE_MB=1024
CDM_MAX_EXTRACT_FILES=500
CDM_ALLOWED_UPLOAD_EXTENSIONS=.txt,.log,.csv,.json,.zip

# ---- MySQL container (used by docker-compose) ----
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=cdm_analyzer
MYSQL_USER=cdm
MYSQL_PASSWORD=cdm_password
